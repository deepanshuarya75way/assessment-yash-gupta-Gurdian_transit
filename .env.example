# ==============================================================================
# GUARDIAN TRANSIT AI - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env (do not commit .env to version control)

# 1. Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=guardian_transit_db
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/guardian_transit_db

# 2. Frontend Configuration
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_FACE_MATCH_THRESHOLD=0.85
